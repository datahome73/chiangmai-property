# 清迈房产比价平台 — 后端配置
# 复制为 .env 并填入实际值

# 数据库
DATABASE_URL=postgresql+asyncpg://cmproperty:cmproperty_secret@localhost:5432/cmproperty
DATABASE_URL_SYNC=postgresql://cmproperty:cmproperty_secret@localhost:5432/cmproperty

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 爬虫代理（可选）
PROXY_ENABLED=false
PROXY_URL=

# 服务器
HOST=0.0.0.0
PORT=8000
DEBUG=true
