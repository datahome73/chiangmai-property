# 清迈房产比价平台 — Railway 生产部署
# 以下配置仅在 Railway 环境覆盖默认值

ENV=production
DEBUG=false

# 数据库 — Railway 会自动提供 PostgreSQL 连接串
# 不要在这里写死，创建 Railway PostgreSQL 插件后会自动注入
# DATABASE_URL 由 Railway Postgres 插件自动设置
# DATABASE_URL_SYNC 同理

# JWT Secret — 在 Railway Dashboard 中设置
# SECRET_KEY=your-production-secret

# 爬虫代理（可选）
PROXY_ENABLED=false
